{
  "name": "theremin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "predev": "node scripts/build-worker.mjs",
    "prebuild": "node scripts/build-worker.mjs",
    "build:pages": "npm run build -- --base=/THEREMIN/ --outDir=dist-pages"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
